# ===== AI Sentinel Configuration =====
# Copy this file to .env and fill in your values

# --- Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ai_sentinel
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=ai_sentinel

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- LLM (LiteLLM-compatible) ---
# Cloud API keys (fill the ones you have)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Active model (litellm format): e.g. "gpt-4o", "claude-sonnet-4-5", "ollama/qwen2.5"
LLM_MODEL=gpt-4o-mini
LLM_MODEL_FALLBACK=ollama/qwen2.5

# --- Embeddings ---
# "local" = sentence-transformers (free, runs in-process) | "openai" = API
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Web Search (for online Q&A / deep research) ---
# "searxng" (self-hosted, free) | "tavily" | "brave"
WEB_SEARCH_PROVIDER=searxng
SEARXNG_URL=http://searxng:8080
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- Whisper (audio transcription) ---
# "local" = faster-whisper | "api"
WHISPER_PROVIDER=local
WHISPER_MODEL=small

# --- Collector schedule (minutes) ---
COLLECT_INTERVAL_MINUTES=60

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
